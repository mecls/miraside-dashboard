{
  "name": "Miraside — Facebook Sync (scheduled)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 30 }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Every 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dashboard.miraside.co/api/sync/facebook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-sync-token", "value": "={{ $env.SYNC_TRIGGER_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"backfillDays\": 14,\n  \"windowDays\": 30\n}",
        "options": {
          "timeout": 320000
        }
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "POST /api/sync/facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {},
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Sync OK",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 200]
    },
    {
      "parameters": {},
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "ALERT — FB sync failed (wire Slack/email here)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 420]
    }
  ],
  "connections": {
    "Every 30 min": {
      "main": [
        [
          { "node": "POST /api/sync/facebook", "type": "main", "index": 0 }
        ]
      ]
    },
    "POST /api/sync/facebook": {
      "main": [
        [
          { "node": "Sync OK", "type": "main", "index": 0 }
        ],
        [
          { "node": "ALERT — FB sync failed (wire Slack/email here)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
